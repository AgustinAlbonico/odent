{
  "name": "@sistema-odontologico/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file ../../.env --import tsx/esm dist/apps/api/src/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file ../../.env --import tsx/esm dist/apps/api/src/main.js",
    "lint": "biome check src test package.json tsconfig.json nest-cli.json biome.json vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file ../../.env src/seed.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@sistema-odontologico/audit-core": "workspace:*",
    "@sistema-odontologico/auth-core": "workspace:*",
    "@sistema-odontologico/permissions": "workspace:*",
    "@sistema-odontologico/tenancy-core": "workspace:*",
    "@sistema-odontologico/types": "workspace:*",
    "@sistema-odontologico/validation": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@sistema-odontologico/tsconfig": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.21.0"
  }
}

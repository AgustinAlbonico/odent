NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistema_odontologico
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# Email Service (SMTP)
# Leave SMTP_HOST empty/unset to use dev mode (token returned in API response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DentalSoft <no-reply@dentalsoft.com>"
FRONTEND_URL=http://localhost:3000

# Resend (email backup for reminders)
RESEND_API_KEY=
RESEND_FROM=noreply@tu-dominio.com

# WhatsApp (WAHA)
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION_NAME=default

# Confirmation window (hours before appointment to send confirmation request)
CONFIRMATION_WINDOW_HOURS=48

# MinIO (S3-compatible file storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=sistema-odontologico

# File upload limits
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp
